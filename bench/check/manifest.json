{
  "schema": "ring.check-benchmark.manifest.v1",
  "description": "B-176 bounded check and validation feedback lanes. Every template expands into separately run cold and warm cache lanes.",
  "fingerprint_flags": {
    "compiler": ["-std=c11", "-O3", "-flto=thin"],
    "runtime": ["-std=c++17", "-D_CRT_SECURE_NO_WARNINGS", "-O3", "-flto=thin"],
    "runner_runtime": ["-std=c++17", "-O2", "-D_CRT_SECURE_NO_WARNINGS"],
    "link": [
      "-flto=thin",
      "-fuse-ld=lld",
      "-lmsvcrt",
      "-Wl,/STACK:536870912",
      "-Wl,/MANIFEST:EMBED",
      "-Wl,/MANIFESTUAC:level='asInvoker'",
      "-Wl,/lldltocachepolicy:cache_size_bytes=1073741824:cache_size_files=4096:prune_after=168h"
    ]
  },
  "lanes": [
    {
      "case_id": "tiny_hello_check",
      "description": "tiny direct successful check",
      "policy": "direct_short",
      "cache_states": ["cold", "warm"],
      "argv": ["{ring}", "check", "{repo}/tests/cases/hello.ring"],
      "cwd": "{repo}",
      "timeout_seconds": 60,
      "expected_exit_codes": [0],
      "requires": ["tool:ring", "path:{repo}/tests/cases/hello.ring"],
      "runner_summary": false,
      "artifacts": [],
      "phase_trace_paths": []
    },
    {
      "case_id": "large_abort_handler_arm_check",
      "description": "representative large single-file check",
      "policy": "direct_short",
      "cache_states": ["cold", "warm"],
      "argv": ["{ring}", "check", "{repo}/tests/cases/golden/abort_handler_arm.ring"],
      "cwd": "{repo}",
      "timeout_seconds": 60,
      "expected_exit_codes": [0],
      "requires": ["tool:ring", "path:{repo}/tests/cases/golden/abort_handler_arm.ring"],
      "runner_summary": false,
      "artifacts": [],
      "phase_trace_paths": []
    },
    {
      "case_id": "diamond_dep_check",
      "description": "representative multi-module diamond dependency check",
      "policy": "direct_short",
      "cache_states": ["cold", "warm"],
      "argv": ["{ring}", "check", "{repo}/tests/cases/modules/diamond_dep/main.ring"],
      "cwd": "{repo}",
      "timeout_seconds": 60,
      "expected_exit_codes": [0],
      "requires": ["tool:ring", "path:{repo}/tests/cases/modules/diamond_dep/main.ring"],
      "runner_summary": false,
      "artifacts": [],
      "phase_trace_paths": []
    },
    {
      "case_id": "error_undefined_llm_check",
      "description": "failing diagnostic path in LLM format",
      "policy": "direct_short",
      "cache_states": ["cold", "warm"],
      "argv": ["{ring}", "check", "{repo}/tests/cases/error_undefined.ring", "--error-format=llm"],
      "cwd": "{repo}",
      "timeout_seconds": 60,
      "expected_exit_codes": [1],
      "requires": ["tool:ring", "path:{repo}/tests/cases/error_undefined.ring"],
      "runner_summary": false,
      "artifacts": [],
      "phase_trace_paths": []
    },
    {
      "case_id": "tiny_hello_rc_check",
      "description": "tiny direct check with static RC verification",
      "policy": "direct_short",
      "cache_states": ["cold", "warm"],
      "argv": ["{ring}", "check", "{repo}/tests/cases/hello.ring", "--verify-rc"],
      "cwd": "{repo}",
      "timeout_seconds": 60,
      "expected_exit_codes": [0],
      "requires": ["tool:ring", "path:{repo}/tests/cases/hello.ring"],
      "runner_summary": false,
      "artifacts": [],
      "phase_trace_paths": []
    },
    {
      "case_id": "compiler_main_check",
      "description": "self-host compiler source check",
      "policy": "adaptive",
      "cache_states": ["cold", "warm"],
      "argv": ["{ring}", "check", "{repo}/compiler/main.ring"],
      "cwd": "{repo}",
      "timeout_seconds": 1200,
      "expected_exit_codes": [0],
      "requires": ["tool:ring", "path:{repo}/compiler/main.ring"],
      "runner_summary": false,
      "artifacts": [],
      "phase_trace_paths": []
    },
    {
      "case_id": "compiler_main_rc_check",
      "description": "self-host compiler source check with static RC verification",
      "policy": "adaptive",
      "cache_states": ["cold", "warm"],
      "argv": ["{ring}", "check", "{repo}/compiler/main.ring", "--verify-rc"],
      "cwd": "{repo}",
      "timeout_seconds": 1200,
      "expected_exit_codes": [0],
      "requires": ["tool:ring", "path:{repo}/compiler/main.ring"],
      "runner_summary": false,
      "artifacts": [],
      "phase_trace_paths": []
    },
    {
      "case_id": "hello_build",
      "description": "single-file Ring check/codegen plus clang object compile",
      "policy": "adaptive",
      "cache_states": ["cold", "warm"],
      "argv": [
        "{ring}",
        "build",
        "{repo}/tests/cases/hello.ring",
        "--target=c",
        "--out-dir={sample_dir}"
      ],
      "cwd": "{repo}",
      "timeout_seconds": 60,
      "expected_exit_codes": [0],
      "requires": ["tool:ring", "tool:clang", "path:{repo}/tests/cases/hello.ring"],
      "runner_summary": false,
      "artifacts": ["{sample_dir}/hello.c", "{sample_dir}/hello.o"],
      "phase_trace_paths": []
    },
    {
      "case_id": "filtered_e2e_hello",
      "description": "one filtered e2e case including isolated compiler construction",
      "policy": "adaptive",
      "cache_states": ["cold", "warm"],
      "argv": ["{python}", "{repo}/tests/run_tests.py", "--suite", "e2e", "--filter", "hello.ring"],
      "cwd": "{repo}",
      "timeout_seconds": 300,
      "expected_exit_codes": [0],
      "requires": ["tool:python", "tool:clang", "tool:clangxx", "path:{repo}/tests/run_tests.py"],
      "runner_summary": true,
      "isolate_runner_runtime": true,
      "artifacts": [],
      "phase_trace_paths": []
    },
    {
      "case_id": "suite_e2e",
      "description": "complete e2e suite",
      "policy": "adaptive",
      "cache_states": ["cold", "warm"],
      "argv": ["{python}", "{repo}/tests/run_tests.py", "--suite", "e2e"],
      "cwd": "{repo}",
      "timeout_seconds": 1800,
      "expected_exit_codes": [0],
      "requires": ["tool:python", "tool:clang", "tool:clangxx", "path:{repo}/tests/run_tests.py"],
      "runner_summary": true,
      "isolate_runner_runtime": true,
      "artifacts": [],
      "phase_trace_paths": []
    },
    {
      "case_id": "suite_golden",
      "description": "complete golden suite",
      "policy": "adaptive",
      "cache_states": ["cold", "warm"],
      "argv": ["{python}", "{repo}/tests/run_tests.py", "--suite", "golden"],
      "cwd": "{repo}",
      "timeout_seconds": 1800,
      "expected_exit_codes": [0],
      "requires": ["tool:python", "tool:clang", "tool:clangxx", "path:{repo}/tests/run_tests.py"],
      "runner_summary": true,
      "isolate_runner_runtime": true,
      "artifacts": [],
      "phase_trace_paths": []
    },
    {
      "case_id": "suite_rc",
      "description": "complete RC verification suite",
      "policy": "adaptive",
      "cache_states": ["cold", "warm"],
      "argv": ["{python}", "{repo}/tests/run_tests.py", "--suite", "rc"],
      "cwd": "{repo}",
      "timeout_seconds": 2400,
      "expected_exit_codes": [0],
      "requires": ["tool:python", "tool:clang", "tool:clangxx", "path:{repo}/tests/run_tests.py"],
      "runner_summary": true,
      "artifacts": [],
      "phase_trace_paths": []
    },
    {
      "case_id": "suite_structural",
      "description": "complete generated-C structural suite",
      "policy": "adaptive",
      "cache_states": ["cold", "warm"],
      "argv": ["{python}", "{repo}/tests/run_tests.py", "--suite", "structural"],
      "cwd": "{repo}",
      "timeout_seconds": 1800,
      "expected_exit_codes": [0],
      "requires": ["tool:python", "tool:clang", "tool:clangxx", "path:{repo}/tests/run_tests.py"],
      "runner_summary": true,
      "artifacts": [],
      "phase_trace_paths": []
    },
    {
      "case_id": "suite_parity",
      "description": "complete static parity evidence suite",
      "policy": "adaptive",
      "cache_states": ["cold", "warm"],
      "argv": ["{python}", "{repo}/tests/run_tests.py", "--suite", "parity"],
      "cwd": "{repo}",
      "timeout_seconds": 300,
      "expected_exit_codes": [0],
      "requires": ["tool:python", "path:{repo}/tests/run_tests.py"],
      "runner_summary": true,
      "artifacts": [],
      "phase_trace_paths": []
    },
    {
      "case_id": "suite_self_compile",
      "description": "tracked C bootstrap fixed-point suite",
      "policy": "adaptive",
      "cache_states": ["cold", "warm"],
      "argv": ["{python}", "{repo}/tests/run_tests.py", "--suite", "self-compile"],
      "cwd": "{repo}",
      "timeout_seconds": 2400,
      "expected_exit_codes": [0],
      "requires": ["tool:python", "tool:clang", "tool:clangxx", "path:{repo}/tests/run_tests.py"],
      "runner_summary": true,
      "artifacts": [],
      "phase_trace_paths": []
    },
    {
      "case_id": "full_gate",
      "description": "complete local C-native standard gate",
      "policy": "full_gate",
      "cache_states": ["cold", "warm"],
      "argv": ["{python}", "{repo}/tests/run_tests.py"],
      "cwd": "{repo}",
      "timeout_seconds": 5400,
      "expected_exit_codes": [0],
      "requires": ["tool:python", "tool:clang", "tool:clangxx", "path:{repo}/tests/run_tests.py"],
      "runner_summary": true,
      "isolate_runner_runtime": true,
      "artifacts": [],
      "phase_trace_paths": []
    },
    {
      "case_id": "tracked_bootstrap_build",
      "description": "fresh tracked C anchor/runtime compile and ThinLTO link",
      "policy": "adaptive",
      "cache_states": ["cold", "warm"],
      "argv": [
        "{python}",
        "{repo}/bench/check/bootstrap.py",
        "--repo",
        "{repo}",
        "--output-dir",
        "{sample_dir}/bootstrap",
        "--clang",
        "{clang}",
        "--clangxx",
        "{clangxx}",
        "--cache",
        "{thinlto_cache}"
      ],
      "cwd": "{repo}",
      "timeout_seconds": 600,
      "expected_exit_codes": [0],
      "requires": [
        "tool:python",
        "tool:clang",
        "tool:clangxx",
        "path:{repo}/bench/check/bootstrap.py",
        "path:{repo}/compiler/dist-c/main.c",
        "path:{repo}/ring_runtime.cpp"
      ],
      "runner_summary": false,
      "artifacts": [
        "{sample_dir}/bootstrap/ring_compiler_lto.o",
        "{sample_dir}/bootstrap/ring_runtime_lto.o",
        "{sample_dir}/bootstrap/ring.exe",
        "{sample_dir}/bootstrap/phase-trace.jsonl"
      ],
      "phase_trace_paths": ["{sample_dir}/bootstrap/phase-trace.jsonl"]
    }
  ]
